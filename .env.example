# Copy to .env (same folder) and change every "change-me".
# Used by Docker Compose AND by the apps when you run them with `pnpm dev`.

# ---------- Database
POSTGRES_PASSWORD=change-me-db
DATABASE_URL=postgresql://home:change-me-db@localhost:5432/home

# ---------- MQTT broker
# The API's broker login
MQTT_URL=mqtt://localhost:1883
MQTT_API_PASSWORD=change-me-mqtt-api
# The login every board uses (typed into the board's setup page)
MQTT_NODE_PASSWORD=change-me-mqtt-node

# ---------- API
API_PORT=4000
# Long random string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-jwt
# Where the web app is opened from (CORS + cookies). Several allowed: comma separated.
WEB_ORIGIN=http://localhost:3000
# false while you test over http://; true in the cloud (https)
COOKIE_SECURE=false

# ---------- Platform features
# true = anyone may create an organization (installer company) at /signup. Keep false until boards have
# their own broker logins: today every board shares MQTT_NODE_PASSWORD, which installers of every tenant see.
ALLOW_SIGNUP=false
# How boards reach the API for firmware updates over Wi-Fi. Empty = this PC's LAN address + API port.
# Allow that port (4000) in Windows Firewall once, like 1883. In the cloud: https://home.example.com
PUBLIC_API_URL=
# Port boards use for MQTT (shown in the add-board wizard). 8883 = TLS in the cloud.
MQTT_PUBLIC_PORT=1883
# Where uploaded firmware .bin files and the Web Push keys are kept (default: ./data/firmware)
FIRMWARE_DIR=
# Web Push keys are created automatically (data/vapid.json). Set these only to use your own.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- Voice assistant (Python)
ASSISTANT_URL=http://localhost:8000
# Shared between the API and the assistant: python -c "import secrets; print(secrets.token_hex(32))"
ASSISTANT_SHARED_SECRET=change-me-assistant
# ollama (free, local) | claude (API key)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
ANTHROPIC_API_KEY=
# claude-sonnet-5-5: understands mixed Urdu/English and tricky requests best. claude-haiku-5-5: cheaper, faster
CLAUDE_MODEL=claude-sonnet-5-5
# Speed: everyday commands ("bulb on", "fan off in 10 minutes", "timer 1 minute", "what's on", "cancel timers")
# are answered in milliseconds without the AI. Anything else goes to the AI.
QUICK_COMMANDS=true
# After the AI only switched or scheduled something, reply from the result instead of asking it a second time
FAST_REPLIES=true
# tiny | base | small (small hears names and Urdu much better; base is faster on a slow PC)
WHISPER_MODEL=small
# Empty = pick between LANGUAGES, or force one: en / ur
LANGUAGE=
LANGUAGES=en,ur
# Used when a home has no time zone of its own
HOME_TIMEZONE=Asia/Karachi
PIPER_MODEL=models/en_US-lessac-medium.onnx

# ---------- Cloud only (Traefik + Let's Encrypt)
DOMAIN=home.example.com
ACME_EMAIL=you@example.com
