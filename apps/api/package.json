{
  "name": "@home/api",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS API: the only writer to the database and the only broker client.",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "prisma": "dotenv -e ../../.env -- prisma",
    "test": "node --test test/unit/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.js",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@home/contracts": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.2.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "mqtt": "^5.10.0",
    "prisma": "^6.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "web-push": "3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/web-push": "3.6.4",
    "dotenv-cli": "^8.0.0",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.7.3"
  }
}
